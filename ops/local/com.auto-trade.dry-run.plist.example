<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.auto-trade.dry-run</string>
  <key>Disabled</key><true/>
  <key>RunAtLoad</key><false/>
  <key>KeepAlive</key><false/>
  <key>WorkingDirectory</key><string>/ABSOLUTE/REVIEWED/REPOSITORY</string>
  <key>ProgramArguments</key><array>
    <string>/ABSOLUTE/PYTHON312/bin/python3.12</string>
    <string>-m</string><string>automation.local_preflight</string><string>--dry-run</string>
  </array>
  <key>StandardOutPath</key><string>/ABSOLUTE/PRIVATE/LOGS/preflight.log</string>
  <key>StandardErrorPath</key><string>/ABSOLUTE/PRIVATE/LOGS/preflight-error.log</string>
  <key>ProcessType</key><string>Background</string>
  <key>Umask</key><integer>63</integer>
</dict></plist>
